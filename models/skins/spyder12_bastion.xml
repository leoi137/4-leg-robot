<mujoco model="spyder12-bastion">
  <!-- CONCEPT SKIN "BASTION — modern heavy walker" — visual exploration only, NOT committed canon.
       Physics skeleton is copied 1:1 from models/spyder12.xml; every added geom
       is class "skin" (no contact, no mass), so dynamics are byte-identical.
       Verified by scripts in the session (body_mass/inertia match). -->
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option integrator="RK4" timestep="0.01"/>
  <visual><global offwidth="1000" offheight="700"/></visual>

  <default>
    <joint armature="1" damping="1" stiffness="30" limited="true"/>
    <geom condim="3" density="5.0" friction="1 0.5 0.5" margin="0.01" rgba="0.55 0.55 0.58 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="150"/>
    <default class="skin">
      <!-- rgba must stay at MuJoCo's internal default (0.5 0.5 0.5 1) or it
           overrides every material color on these geoms -->
      <geom contype="0" conaffinity="0" density="0" group="1" rgba="0.5 0.5 0.5 1"/>
    </default>
  </default>

  <asset>
    <material name="drab"     rgba="0.295 0.305 0.225 1" specular="0.18" shininess="0.2"/>
