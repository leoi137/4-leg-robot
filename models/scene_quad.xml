<mujoco model="spyder_quad scene">
  <!-- World wrapper for the 12-DoF tank quad: pulls in the robot, adds floor + sky
       + light. This is the file you view and train (Spyder-v0 points at it).
       Styled as a night desert (like docs/media/4_leg_robot.png): dark sky, sandy
       ground, one warm low-angle key light so the amber emissives glow. Purely
       cosmetic — physics (floor friction/contact) is unchanged. -->
  <include file="spyder_quad.xml"/>

  <statistic center="0 0 0.3" extent="1.6"/>

  <visual>
    <headlight diffuse="0.18 0.17 0.16" ambient="0.12 0.12 0.14" specular="0.05 0.05 0.05"/>
    <rgba haze="0.06 0.06 0.09 1"/>
    <global azimuth="160" elevation="-12"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.02 0.02 0.05" rgb2="0.10 0.09 0.13" width="64" height="64"/>
    <texture name="sand" type="2d" builtin="checker" rgb1="0.23 0.19 0.14" rgb2="0.26 0.22 0.16" width="256" height="256"/>
    <material name="sand" texture="sand" texrepeat="20 20" reflectance="0.03"/>
  </asset>

  <worldbody>
    <!-- warm key light raking in low from the front-left, like the reference shot -->
    <light pos="2.5 -1.5 1.2" dir="-0.8 0.5 -0.45" directional="true" diffuse="0.55 0.45 0.33" specular="0.3 0.25 0.18"/>
    <!-- faint cool moonlight fill from above so shadows aren't pure black -->
    <light pos="-1 1 3" dir="0.3 -0.3 -1" directional="true" diffuse="0.10 0.11 0.15"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="sand" condim="3" conaffinity="1" friction="1 0.5 0.5"/>
  </worldbody>
</mujoco>
